  "transcript": [
   {
    "role": "agent",
    "text": "Hi, this is HungerCue. Are you calling to donate food, for a shelter, or to volunteer?",
    "at": "2026-11-05T18:43:02"
   },
   {
    "role": "caller",
    "text": "Hi. I'm calling from Sunrise Bagels. We have some surplus food we'd like to donate.",
    "at": "2026-11-05T18:43:15"
   },
   {
    "role": "agent",
    "text": "Thanks for calling from Sunrise Bagels. What food items do you have to donate?",
    "at": "2026-11-05T18:43:18"
   },
   {
    "role": "caller",
    "text": "We have pastries and muffins to donate.",
    "at": "2026-11-05T18:43:28"
   },
   {
    "role": "agent",
    "text": "How many pastries and muffins do you have, roughly?",
    "at": "2026-11-05T18:43:30"
   },
   {
    "role": "caller",
    "text": "We have about two large boxes of pastries and muffins.",
    "at": "2026-11-05T18:43:40"
   },
   {
    "role": "agent",
    "text": "What date and time window can volunteers pick up the boxes?",
    "at": "2026-11-05T18:43:42"
   },
   {
    "role": "caller",
    "text": "Tomorrow, between six 8PM would be great for the pickup.",
    "at": "2026-11-05T18:43:55"
   },
   {
    "role": "agent",
    "text": "Could you please confirm the pickup address for Sunrise Bagels?",
    "at": "2026-11-05T18:43:57"
   },
   {
    "role": "caller",
    "text": "Yes. 2210 Broadway.",
    "at": "2026-11-05T18:44:07"
   },
   {
    "role": "agent",
    "text": "Are there any dietary notes like contains nuts, vegetarian, or halal for the pastries and muffins?",
    "at": "2026-11-05T18:44:09"
   },
   {
    "role": "caller",
    "text": "I'm not sure about that. Sorry.",
    "at": "2026-11-05T18:44:22"
   },
   {
    "role": "agent",
    "text": "To confirm, Sunrise Bagels will donate two large boxes of pastries and muffins for pickup tomorrow between six PM and eight PM at 2210 Broadway, with no specific dietary notes. Is that right?",
    "at": "2026-11-05T18:44:25"
   },
   {
    "role": "caller",
    "text": "Yes. That's correct. Thank you.",
    "at": "2026-11-05T18:44:41"
   },
   {
    "role": "agent",
    "text": "Thank you, Sunrise Bagels. You will get a text confirmation with the pickup time and the volunteer's name. Is there anything else I can help you with?",
    "at": "2026-11-05T18:44:44"
   }
