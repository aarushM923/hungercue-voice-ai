   {
    "role": "caller",
    "text": "It's 2210 Broadway.",
    "at": "2026-11-05T18:52:48"
   },
   {
    "role": "agent",
    "text": "Does the food contain any pork, nuts, or have other dietary notes like vegetarian or halal?",
    "at": "2026-11-05T18:52:51"
