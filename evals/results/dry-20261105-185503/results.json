  "transcript": [
   {
    "role": "agent",
    "text": "Hi, this is HungerCue. Are you calling to donate food, for a shelter, or to volunteer?",
    "at": "2026-11-05T18:55:03"
   },
   {
    "role": "caller",
    "text": "Hi. I'm calling to sign up as a volunteer driver or picker upper for food pickups.",
    "at": "2026-11-05T18:55:17"
   },
   {
    "role": "agent",
    "text": "Great! Can I have your name, please?",
    "at": "2026-11-05T18:55:18"
   },
   {
    "role": "caller",
    "text": "Sure. It's James.",
    "at": "2026-11-05T18:55:22"
   },
   {
    "role": "agent",
    "text": "Thanks, James. What days and times are you available to volunteer?",
    "at": "2026-11-05T18:55:24"
   },
   {
    "role": "caller",
    "text": "I'm available on Mondays and Tuesdays, usually from around ten in the morning until about four in the afternoon.",
    "at": "2026-11-05T18:55:35"
   },
   {
    "role": "agent",
    "text": "Which neighborhoods in New York City would you prefer to volunteer in?",
    "at": "2026-11-05T18:55:36"
   },
   {
    "role": "caller",
    "text": "I can cover the Parksloe neighborhood.",
    "at": "2026-11-05T18:55:43"
   },
   {
    "role": "agent",
    "text": "Do you have a car to help with food pickups?",
    "at": "2026-11-05T18:55:44"
   },
   {
    "role": "caller",
    "text": "I don't have a so I would be taking the subway to get around.",
    "at": "2026-11-05T18:55:51"
   },
   {
    "role": "agent",
    "text": "Thanks, James. We will text you pickup offers for Parksloe on Mondays and Tuesdays from ten AM to four PM. Is there anything else I can help you with?",
    "at": "2026-11-05T18:55:55"
   },
   {
    "role": "caller",
    "text": "Yes. Just to confirm, it's Slope. Right?",
    "at": "2026-11-05T18:56:06"
   },
   {
    "role": "agent",
    "text": " [interrupted]",
    "at": "2026-11-05T18:56:06"
   },
   {
    "role": "caller",
    "text": "And the times are Monday and Tuesday, 10AM to 4PM.",
    "at": "2026-11-05T18:56:09"
   },
   {
    "role": "agent",
    "text": "Thanks for clarifying, James. You are available Mondays and Tuesdays from ten AM to four PM in the Park Slope neighborhood, without a car. Is that correct?",
    "at": "2026-11-05T18:56:13"
   },
   {
    "role": "caller",
    "text": "Yes. That's correct. Thanks for your help.",
    "at": "2026-11-05T18:56:22"
