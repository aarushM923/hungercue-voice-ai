  "transcript": [
   {
    "role": "agent",
    "text": "Hi, this is HungerCue. Are you calling to donate food, for a shelter, or to volunteer?",
    "at": "2026-11-05T18:48:50"
   },
   {
    "role": "caller",
    "text": "Hi. I'm calling to donate some surplus food from my restaurant.",
    "at": "2026-11-05T18:49:03"
   },
   {
    "role": "agent",
    "text": "Great! What is the name of your restaurant?",
    "at": "2026-11-05T18:49:05"
   },
   {
    "role": "caller",
    "text": "It's Sunrise Bagels.",
    "at": "2026-11-05T18:49:10"
   },
   {
    "role": "agent",
    "text": "Thanks. What food items do you have to donate?",
    "at": "2026-11-05T18:49:12"
   },
   {
    "role": "caller",
    "text": "We have pastries and muffins ready to donate.",
    "at": "2026-11-05T18:49:19"
   },
   {
    "role": "agent",
    "text": "How many pastries and muffins do you have, roughly?",
    "at": "2026-11-05T18:49:21"
   },
   {
    "role": "caller",
    "text": "About two large boxes.",
    "at": "2026-11-05T18:49:27"
   },
   {
    "role": "agent",
    "text": "When can the food be picked up? Please give me the date and the start and end time for the pickup window.",
    "at": "2026-11-05T18:49:29"
   },
   {
    "role": "caller",
    "text": "It can be picked up tomorrow between six and 8PM.",
    "at": "2026-11-05T18:49:39"
   },
   {
    "role": "agent",
    "text": "What is the pickup address for Sunrise Bagels?",
    "at": "2026-11-05T18:49:41"
   },
   {
    "role": "caller",
    "text": "The address is twenty two ten Broadway,",
    "at": "2026-11-05T18:49:47"
   },
   {
    "role": "agent",
    "text": "Does the food contain any pork, nuts, or is it vegetarian or halal?",
    "at": "2026-11-05T18:49:49"
   },
   {
    "role": "caller",
    "text": "I'm not sure about that. Sorry.",
    "at": "2026-11-05T18:49:58"
   },
   {
    "role": "agent",
    "text": "No problem. To confirm, Sunrise Bagels is donating two large boxes of pastries and muffins for pickup tomorrow between six and eight PM at twenty two ten Broadway. Is that right?",
    "at": "2026-11-05T18:50:03"
   },
   {
    "role": "caller",
    "text": "Yes.",
    "at": "2026-11-05T18:50:14"
   },
   {
    "role": "agent",
    "text": " [interrupted]",
    "at": "2026-11-05T18:50:15"
   },
   {
    "role": "caller",
    "text": "Correct.",
    "at": "2026-11-05T18:50:15"
   },
   {
    "role": "agent",
    "text": "Thank you! You will get a text confirmation with the pickup time and the volunteer's name. Is there anything else I can help you with?",
    "at": "2026-11-05T18:50:19"
   }
