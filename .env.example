# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# ---- Server ----
# Public HTTPS URL where Twilio reaches this app (tunnel or deploy URL), no trailing slash
PUBLIC_BASE_URL=https://your-public-url.example

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Number SMS is sent from, E.164 format
TWILIO_PHONE_NUMBER=+12125550100
# Human coordinator that transfer_to_human() forwards calls to
COORDINATOR_PHONE=+12125550199

# ---- AI providers ----
OPENAI_API_KEY=sk-your-openai-key
DEEPGRAM_API_KEY=your-deepgram-key

# ---- Storage ----
# Local default is SQLite. Production example: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./hungercue.db
# Leave empty to use an in-memory fake Redis locally. Production: redis://...
REDIS_URL=

# ---- Google Sheets (coordinator log) ----
GOOGLE_CREDENTIALS_JSON=google-credentials.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=HungerCue Calls
ROLE_TABS=1

# ---- Dashboard (leave password empty to disable the dashboard) ----
DASHBOARD_USER=coordinator
DASHBOARD_PASSWORD=
