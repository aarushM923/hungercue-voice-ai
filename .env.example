# ---- Flask ----
FLASK_ENV=development
PORT=5000

# Public base URL where Twilio can reach your app (ngrok/Cloudflare/etc.), no trailing slash
PUBLIC_BASE_URL=https://your-public-url.example

# ---- Google Sheets ----
GOOGLE_CREDENTIALS_JSON=google-credentials.json
# If you have the ID (recommended), set it; otherwise the name will be used
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=HungerCue Calls

# Create three tabs if you want role-based logging:
# Volunteers | Restaurants | Shelters
ROLE_TABS=1

# ---- OpenAI ----
OPENAI_API_KEY=sk-your-openai-key
